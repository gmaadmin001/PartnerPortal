NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Resend — one key covers the HTTP API and smtp.resend.com
RESEND_API_KEY=re_...
# Sender must be on a domain verified in Resend
EMAIL_FROM=ReloCentra Partner Portal <noreply@globalmobilityadviser.com>
# Cloudflare account this Worker deploys to - must match account_id in wrangler.jsonc
CLOUDFLARE_ACCOUNT_EMAIL=gmaadmin001@gmail.com
SUPABASE_AUTH_HOOK_SECRET=

# Stripe — test keys locally (pk_test_*/sk_test_*), live keys in production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Local: the whsec_ printed by `stripe listen`. Production: the dashboard webhook endpoint's whsec_
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=
STRIPE_PREMIER_MONTHLY_PRICE_ID=
STRIPE_PREMIER_ANNUAL_PRICE_ID=
STRIPE_VERIFIED_BADGE_PRICE_ID=
